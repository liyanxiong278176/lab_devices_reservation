LAB_ENVIRONMENT=local
LAB_DEBUG=true
LAB_API_PREFIX=/api/v2
LAB_MYSQL_DSN=mysql+asyncmy://root:change-me@127.0.0.1:3306/lab_reservation?charset=utf8mb4
LAB_REDIS_URL=redis://127.0.0.1:6379/0
LAB_REDIS_SOCKET_TIMEOUT_SECONDS=0.5
LAB_REDIS_CIRCUIT_FAILURE_THRESHOLD=3
LAB_REDIS_CIRCUIT_RECOVERY_SECONDS=5
LAB_QDRANT_URL=http://127.0.0.1:6333
LAB_CORS_ORIGINS=["http://localhost:5173"]
LAB_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
LAB_JWT_ISSUER=lab-reservation
LAB_ENABLE_WORKERS=true
LAB_BOOTSTRAP_ADMIN_USERNAME=admin
LAB_BOOTSTRAP_ADMIN_PASSWORD=

# Reliability and performance tuning (all have safe defaults).
LAB_DB_POOL_SIZE=10
LAB_DB_MAX_OVERFLOW=20
LAB_DB_POOL_TIMEOUT_SECONDS=10
LAB_OUTBOX_MAX_ATTEMPTS=5
LAB_OUTBOX_WORKER_CONCURRENCY=4
LAB_RESERVATION_LOCK_WAIT_SECONDS=2
LAB_RESERVATION_LOCK_TTL_SECONDS=8
LAB_CACHE_DEFAULT_TTL_SECONDS=300
LAB_CACHE_TTL_JITTER_SECONDS=60
LAB_RATE_LIMIT_ENABLED=true
LAB_RATE_LIMIT_DEFAULT_CAPACITY=60
LAB_RATE_LIMIT_RESERVATION_CAPACITY=10
LAB_RATE_LIMIT_REPAIR_CAPACITY=10

# Optional server-managed model configuration; users cannot supply keys or URLs.
LAB_AI_PROVIDER=openai
LAB_AI_MODEL=gpt-4o-mini
LAB_AI_API_KEY=
LAB_AI_BASE_URL=https://api.openai.com/v1
LAB_AI_EMBEDDING_MODEL=text-embedding-3-small
LAB_AI_EMBEDDING_DIMENSION=1536
LAB_AI_QDRANT_COLLECTION=lab_knowledge_v2
LAB_AI_QDRANT_TIMEOUT_SECONDS=5
