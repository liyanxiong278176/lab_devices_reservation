# Shared Compose, backend, and frontend settings. Generate 32 random bytes and encode as
# lowercase hex (PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLowerInvariant())
DB_ROOT_PASSWORD=
DB_APP_USER=lab_runtime
DB_APP_PASSWORD=

# Required only by docker-compose.prod.yml; do not use a development value.
JWT_SECRET=
# Public HTTPS origin used by the frontend and cookie/CSRF Origin validation.
APP_PUBLIC_ORIGIN=https://lab.example.edu

# Runtime observability. Use independent random 32-byte hex values for each secret.
# Keep this equal to LAB_METRICS_TOKEN below; both names are stored in this root file.
PROMETHEUS_METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Host-side localhost port; change if the default is already occupied.
GRAFANA_PORT=3000
MYSQL_EXPORTER_PASSWORD=

# Backend runtime settings (FastAPI and Celery).
LAB_ENVIRONMENT=local
LAB_DEBUG=true
LAB_API_PREFIX=/api/v2
LAB_MYSQL_DSN=mysql+asyncmy://lab_runtime:replace-with-64-hex-characters@127.0.0.1:3306/lab_reservation?charset=utf8mb4
LAB_REDIS_URL=redis://127.0.0.1:6379/0
LAB_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
LAB_CELERY_VISIBILITY_TIMEOUT_SECONDS=7260
LAB_CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=7140
LAB_CELERY_TASK_TIME_LIMIT_SECONDS=7200
LAB_CELERY_WORKER_CONCURRENCY=1
LAB_AI_KNOWLEDGE_BUILD_EMBED_BATCH_SIZE=32
LAB_AI_KNOWLEDGE_BUILD_LEASE_SECONDS=300
LAB_AI_KNOWLEDGE_BUILD_DISPATCH_RECOVERY_SECONDS=600
LAB_AI_KNOWLEDGE_BUILD_RECONCILE_INTERVAL_SECONDS=30
LAB_AI_KNOWLEDGE_BUILD_MAX_REDELIVERIES=3
LAB_AI_RAG_QUERY_CONCURRENCY=4
LAB_REDIS_SOCKET_TIMEOUT_SECONDS=0.5
LAB_REDIS_CIRCUIT_FAILURE_THRESHOLD=3
LAB_REDIS_CIRCUIT_RECOVERY_SECONDS=5
LAB_QDRANT_URL=http://127.0.0.1:6333
LAB_CORS_ORIGINS=["http://localhost:5173"]
# 仅填写实际反向代理的固定 IP/CIDR；为空时忽略所有 X-Forwarded-For。
LAB_TRUSTED_PROXY_IPS=[]
# Used by direct backend runs; production Compose maps JWT_SECRET into this setting.
LAB_JWT_SECRET=
# Local HTTP development may use false; production behind HTTPS must set true.
LAB_COOKIE_SECURE=false
# Keep equal to PROMETHEUS_METRICS_TOKEN; production Compose maps it automatically.
LAB_METRICS_TOKEN=
LAB_JWT_ISSUER=lab-reservation
LAB_ENABLE_WORKERS=true
LAB_UPLOAD_COLLEGE_QUOTA_BYTES=1073741824
LAB_AI_KNOWLEDGE_GLOBAL_STORAGE_BYTES=1073741824
LAB_AI_KNOWLEDGE_COLLEGE_STORAGE_BYTES=536870912
LAB_BOOTSTRAP_ADMIN_USERNAME=admin
LAB_BOOTSTRAP_ADMIN_PASSWORD=

# Reliability and performance tuning (all have safe defaults).
LAB_DB_POOL_SIZE=10
LAB_DB_MAX_OVERFLOW=20
LAB_DB_POOL_TIMEOUT_SECONDS=10
LAB_REQUEST_QUEUE_CAPACITY=1000
LAB_OUTBOX_MAX_ATTEMPTS=5
LAB_OUTBOX_WORKER_CONCURRENCY=4
# Optional: set a stable, unique group ID per API process to recover its PEL after restart.
# If omitted, the runtime uses hostname and PID; do not share one ID across API processes.
# LAB_NOTIFICATION_STREAM_GROUP_ID=api-replica-1
LAB_NOTIFICATION_STREAM_CONSUMER_CONCURRENCY=4
LAB_NOTIFICATION_STREAM_RETRY_BASE_SECONDS=5
LAB_NOTIFICATION_STREAM_MAX_ATTEMPTS=5
LAB_NOTIFICATION_SSE_MAX_CONNECTIONS=500
LAB_NOTIFICATION_SSE_MAX_PER_USER=5
LAB_NOTIFICATION_SSE_MAX_PENDING=100
LAB_NOTIFICATION_SSE_MAX_PENDING_PER_IP=5
LAB_NOTIFICATION_SSE_HEARTBEAT_SECONDS=20
LAB_NOTIFICATION_SSE_REVALIDATE_SECONDS=60
# Hard cap is 100; larger offline history is read through the HTTP API.
LAB_NOTIFICATION_SSE_MAX_REPLAY_EVENTS=100
LAB_RESERVATION_LOCK_WAIT_SECONDS=2
LAB_RESERVATION_LOCK_TTL_SECONDS=8
LAB_CACHE_DEFAULT_TTL_SECONDS=300
LAB_CACHE_TTL_JITTER_SECONDS=60
LAB_RATE_LIMIT_ENABLED=true
LAB_RATE_LIMIT_DEFAULT_CAPACITY=300
LAB_RATE_LIMIT_DEFAULT_REFILL_PER_SECOND=5.0
LAB_RATE_LIMIT_LOGIN_IP_CAPACITY=30
LAB_RATE_LIMIT_LOGIN_IP_REFILL_PER_SECOND=0.5
LAB_RATE_LIMIT_LOGIN_CAPACITY=5
LAB_RATE_LIMIT_LOGIN_REFILL_PER_SECOND=0.0833333333
LAB_RATE_LIMIT_RESERVATION_CAPACITY=10
LAB_RATE_LIMIT_REPAIR_CAPACITY=10

# Backend AI provider settings are loaded from the root .env.
# Keep the actual root .env untracked; never put credentials in source control or browser storage.
LAB_AI_PROVIDER=deepseek
LAB_AI_MODEL=deepseek-flash
LAB_AI_API_KEY=
LAB_AI_BASE_URL=https://api.deepseek.com
LAB_AI_ALLOWED_MODELS=["deepseek-flash"]
LAB_AI_EMBEDDING_PROVIDER=siliconflow
LAB_AI_EMBEDDING_MODEL=BAAI/bge-m3
LAB_AI_EMBEDDING_API_KEY=
LAB_AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LAB_AI_EMBEDDING_DIMENSION=1024
LAB_AI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LAB_AI_MINERU_MODEL=vlm
LAB_AI_MINERU_API_KEY=
LAB_AI_MINERU_BASE_URL=https://mineru.net
LAB_AI_USER_DAILY_TOKEN_CAP=100000
LAB_AI_COLLEGE_DAILY_TOKEN_CAP=1000000
LAB_AI_GLOBAL_DAILY_TOKEN_CAP=10000000
LAB_AI_QDRANT_COLLECTION=lab_knowledge_v2
LAB_AI_QDRANT_TIMEOUT_SECONDS=5

# Optional Vite dev proxy target; blank uses localhost:8000.
VITE_API_PROXY_TARGET=
# Frontend WebSocket base; blank uses the current origin.
VITE_WS_BASE=
